# How files in this repository are indented and ended, for any editor that reads EditorConfig
# (VS Code needs its EditorConfig extension, which .vscode/extensions.json recommends).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

# Trailing spaces can be a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# The test data is kept compact, as the backup export writes JSON.
[tests/fixtures/*.json]
indent_size = 1
